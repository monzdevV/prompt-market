# Copia este archivo a .env y rellena lo que tengas. Todo es opcional salvo lo que se indica.

# Canal activo (archivo en channels/)
CHANNEL=curiosidad

# --- Guiones ---
# Con clave: usa la API de Anthropic. Sin clave: usa `claude -p` (tu sesión de Claude Code).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Sistema ---
# Comando o ruta de Python para edge-tts (por defecto: python3 en macOS/Linux, python en Windows).
PYTHON=

# --- Voz ---
# edge-tts es gratis y no necesita clave. ElevenLabs suena mejor (plan Starter ~6 $/mes).
ELEVENLABS_API_KEY=

# --- Material visual (gratis) --- https://www.pexels.com/api/
PEXELS_API_KEY=

# --- YouTube ---
# OAuth: Google Cloud Console → Credenciales → ID de cliente OAuth tipo "App de escritorio".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Clave de API simple (solo lectura) para buscar outliers: Credenciales → Clave de API.
YOUTUBE_API_KEY=
