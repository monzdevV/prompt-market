{
  "expo": {
    "name": "PartyUp",
    "slug": "previasplus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-ios.png",
    "scheme": "previasplus",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0A0B",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0B"
    },
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/images/icon-ios.png",
      "bundleIdentifier": "com.previasplus.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "PartyUp needs camera access to capture photos and videos during your parties",
        "NSPhotoLibraryUsageDescription": "PartyUp needs access to your gallery to save and share the best moments",
        "NSPhotoLibraryAddUsageDescription": "PartyUp needs permission to save photos and videos to your gallery",
        "NSLocationWhenInUseUsageDescription": "PartyUp needs your location to show nearby clubs and venues",
        "NSMicrophoneUsageDescription": "PartyUp needs microphone access to record videos with audio",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:previasplus.app",
        "applinks:www.previasplus.app"
      ],
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ],
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.previasplus.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon-splash.png",
          "imageWidth": 80,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0B",
          "dark": {
            "backgroundColor": "#0A0A0B"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PartyUp needs camera access to capture photos and videos during your parties",
          "microphonePermission": "PartyUp needs microphone access to record videos with audio",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "PartyUp needs access to your gallery to save and share the best moments",
          "savePhotosPermission": "PartyUp needs permission to save photos and videos to your gallery",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#BFFF00"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.TU_IOS_CLIENT_ID"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PartyUp needs your location to show nearby clubs and venues"
        }
      ],
      "expo-localization",
      "expo-system-ui",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "legal": {
        "privacyPolicyUrl": "TU_URL_DE_POLITICA_DE_PRIVACIDAD",
        "termsOfServiceUrl": "TU_URL_DE_TERMINOS_DE_USO",
        "supportEmail": "TU_EMAIL_DE_SOPORTE"
      }
    }
  }
}
