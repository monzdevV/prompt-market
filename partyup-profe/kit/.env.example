# Copia este archivo como .env y rellena los valores (nunca lo subas a git).

# Supabase -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-o-publishable-key

# Google Sign-In (Google Cloud Console -> Credentials -> OAuth client IDs)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxx-xxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx-yyyy.apps.googleusercontent.com

# RevenueCat (suscripción Pro). Si la dejas vacía la app arranca sin compras ni Pro
# (la configuración se salta con un aviso); compruébalo en tu development build.
EXPO_PUBLIC_REVENUECAT_API_KEY=
