# Copia este archivo como .env.local y rellena lo que vayas usando.

# URL pública de la app (la que registras como redirección en cada red). Con HTTPS las cookies van marcadas como seguras.
APP_URL=http://localhost:3000

# Clave para cifrar los tokens de las redes (32 bytes en base64). Genérala UNA vez y no la pierdas:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si cambia, todas las cuentas conectadas tendrán que reconectarse.
TOKEN_ENC_KEY=

# Email del administrador: solo ese email puede crear la primera cuenta (recomendado si la app es accesible desde internet)
ADMIN_EMAIL=

# Registro: "invite" (solo con invitación, recomendado en beta) u "open" (cualquiera).
# El primer usuario que se registra no necesita invitación y queda como administrador.
SIGNUP_MODE=invite

# Tamaño máximo de vídeo, en MB. El espacio total lo marca el plan (STORAGE_QUOTA_MB, si se pone, es un tope global)
MAX_UPLOAD_MB=500
STORAGE_QUOTA_MB=

# Zona horaria del calendario y las fechas
APP_TIMEZONE=Europe/Madrid

# De qué proxy fiarse para saber la IP real (límites de intentos): cloudflare | forwarded | none
# Con "cloudflare", arranca el servidor solo en local (npm start -- -H 127.0.0.1) y entra por el túnel
TRUST_PROXY=cloudflare

# IA para títulos, descripciones y hashtags: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Modelo (por defecto claude-sonnet-5)
AI_MODEL=

# Transcripción local con faster-whisper (pip install faster-whisper)
TRANSCRIBER=local
PYTHON_BIN=python
# tiny | base | small | medium | large-v3  (más grande = más preciso y más lento)
WHISPER_MODEL=small
# Tiempo máximo por vídeo, en segundos
WHISPER_TIMEOUT_S=1800

# Datos del titular: aparecen en Aviso legal, Privacidad y Términos (los exige la LSSI y las redes los revisan).
# Mientras falten, esas páginas muestran «[pendiente]» en su lugar.
LEGAL_NAME=           # nombre y apellidos (autónomo) o razón social
LEGAL_ID=             # NIF / CIF
LEGAL_ADDRESS=        # domicilio: calle, código postal y ciudad
LEGAL_REGISTRY=       # solo sociedades: datos del Registro Mercantil
CONTACT_EMAIL=        # email de contacto y de privacidad

# Servicio de publicación Upload-Post (https://app.upload-post.com → API Keys). Con la clave puesta, los clientes
# conectan TikTok, Instagram, YouTube y Facebook en su página (con tu logo) y se publica con sus apps ya aprobadas:
# no hacen falta las revisiones propias de cada red. La marca blanca para clientes va desde su plan Professional.
UPLOAD_POST_API_KEY=
# Solo desarrollo: usar siempre este perfil (el plan gratis admite 2). Se ignora en producción.
UPLOAD_POST_PROFILE=
# Mostrar también la conexión directa con cada red (tus propias apps) aunque Upload-Post esté activo
DIRECT_CONNECT=false

# Facebook + Instagram: https://developers.facebook.com/apps
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0

# YouTube: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok: https://developers.tiktok.com/apps
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Interruptores por red (true por defecto). Ponlos a false para apagar la publicación en esa red.
PUBLISH_INSTAGRAM=true
PUBLISH_FACEBOOK=true
PUBLISH_TIKTOK=true
PUBLISH_YOUTUBE=true
# TikTok: hasta que audite la app solo se publica como "Solo yo" (y la cuenta debe ser privada)
TIKTOK_AUDITED=false
# Programar en TikTok (su documentación no lo prohíbe; apagado hasta confirmarlo en la auditoría)
TIKTOK_ALLOW_SCHEDULING=false

# LinkedIn (desactivado por defecto)
FEATURE_LINKEDIN=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_VERSION=202507

# Logs: debug | info
LOG_LEVEL=info

# Email (verificación, recuperación de contraseña, invitaciones de equipo) con Resend: https://resend.com
# Sin configurar, en desarrollo los enlaces se escriben en el log (MAIL_LOG=true para verlos también con npm start)
RESEND_API_KEY=
MAIL_FROM=
MAIL_LOG=false

# Cada cuántas horas se sincroniza la analítica de cada cuenta
SYNC_INTERVAL_HOURS=6

# Días que se guardan en disco los vídeos ya publicados (la transcripción y las métricas se conservan)
UPLOAD_RETENTION_DAYS=30
# Copias de seguridad diarias de la base que se conservan (en data/backups)
BACKUP_KEEP=14

# Pagos con Stripe (https://dashboard.stripe.com). Sin STRIPE_SECRET_KEY los planes de pago muestran «Próximamente».
# 1) Crea en Stripe un producto por plan con su precio mensual recurrente y pega aquí los ids price_…
# 2) Webhook → https://TU-DOMINIO/api/billing/webhook con los eventos checkout.session.completed y
#    customer.subscription.created / updated / deleted; pega su secreto whsec_…
# 3) Activa el portal del cliente en Stripe (Configuración → Billing → Portal del cliente)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Manny, el mánager (solo funciona en tu ordenador)
# Piensa con Claude Code instalado y con tu sesión iniciada (suscripción, sin API de pago).
# MANNY_MODEL=sonnet
# MANNY_CLAUDE_BIN=claude
# Lee TikTok y YouTube con yt-dlp:  pip install yt-dlp curl_cffi
# (curl_cffi hace que TikTok no bloquee la lectura). Por defecto se ejecuta con PYTHON_BIN -m yt_dlp.
# MANNY_YTDLP=
